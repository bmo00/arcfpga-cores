##
## DEVICE  "EP4CGX150DF27I7"
##
## This target does NOT pull in target/mist/syn/mist_io.sdc or
## target/mist/syn/sdram_clk.sdc (see the NEPTUNOPLUS exclusions added to
## target/mist/cfg/common.yaml). Both are needed, but their content can't
## be used as-is:
##
## 1. mist_io.sdc hardcodes `create_clock -name {CLOCK_27[0]} -period
##    37.037` (27MHz), which is correct for MiST/SiDi128 but WRONG here:
##    neptUNO+ only has a single 50MHz oscillator (period 20ns) wired to
##    that same port name, converted to 27MHz internally by
##    jtframe_pll_neptunoplus.
##
## 2. jtframe_neptunoplus_top.sv (TOP_LEVEL_ENTITY) instantiates
##    jtframe_mist_clocks/jtframe_mist directly (u_clocks/u_frame), same as
##    target/mist's own jtframe_mist_top.sv - no extra wrapper level, so
##    hierarchical paths below match mist_io.sdc/sdram_clk.sdc's bare form.
##    An earlier version of this target wrapped mist_top as a sub-instance
##    "u_guest", which required prefixing every path here with "u_guest|" -
##    that wrapper has been removed, so don't reintroduce the prefix.
##
## It was tempting to just redeclare CLOCK_27[0] correctly in a file read
## "after" mist_io.sdc and let it override, but the file read order across
## a files.yaml is NOT deterministic (JTFiles is a plain Go map in
## src/jtframe/files/types.go, and Go randomizes map iteration order per
## run) - confirmed by seeing this file load BEFORE mist_io.sdc in one real
## build (log showed "Warning (332043): Overwriting existing clock:
## CLOCK_27[0]" with mist_io.sdc's wrong value winning). So instead this
## file is a full copy of both files' content, with CLOCK_27[0] corrected.
##

#**************************************************************
# Time Information
#**************************************************************

set_time_format -unit ns -decimal_places 3

#**************************************************************
# Create Clock
#**************************************************************

# 50MHz oscillator (period 20ns), NOT 27MHz like MiST/SiDi128 - see note above.
create_clock -name {CLOCK_27[0]} -period 20.000 -waveform { 0.000 10.000 } [get_ports {CLOCK_27[0]}]
create_clock -name {SPI_SCK}  -period 41.666 -waveform { 20.8 41.666 } [get_ports {SPI_SCK}]

derive_pll_clocks -create_base_clocks

create_generated_clock -name SDRAM_CLK -source \
    [get_pins {u_clocks|u_pll_game|altpll_component|auto_generated|pll1|clk[0]}] \
    -divide_by 1 \
    [get_ports SDRAM_CLK]

#**************************************************************
# Set Clock Uncertainty
#**************************************************************
derive_clock_uncertainty

#**************************************************************
# Set Clock Groups
#**************************************************************

set_clock_groups -asynchronous -group [get_clocks {SPI_SCK}] -group [get_clocks {*|altpll_component|auto_generated|pll1|clk[*]}]

#**************************************************************
# Set False Path
#**************************************************************

set_false_path -to [get_ports {LED}]
set_false_path -to [get_ports {AUDIO_L}]
set_false_path -to [get_ports {AUDIO_R}]
set_false_path -to [get_ports {VGA_*}]

# Reset synchronization signal
set_false_path -from [get_keepers {jtframe_mist:u_frame|jtframe_board:u_board|jtframe_reset:u_reset|rst_rom[0]}] -to [get_keepers {jtframe_mist:u_frame|jtframe_board:u_board|jtframe_reset:u_reset|rst_rom_sync}]

# I2S audio output is generated by a slow, free-running serializer;
# it does not need to meet setup/hold against clk_sys.
set_false_path -to [get_ports {I2S_BCK I2S_LRCK I2S_DATA}]

#**************************************************************
# Set Input Delay
#**************************************************************

set_input_delay -clock SPI_SCK -max 6.4 [get_ports SPI_DI]
set_input_delay -clock SPI_SCK -min 3.2 [get_ports SPI_DI]
set_input_delay -clock SPI_SCK -max 6.4 [get_ports SPI_SS*]
set_input_delay -clock SPI_SCK -min 3.2 [get_ports SPI_SS*]
set_input_delay -clock SPI_SCK -max 6.4 [get_ports CONF_DATA0]
set_input_delay -clock SPI_SCK -min 3.2 [get_ports CONF_DATA0]

# SDRAM tAC/tOH, from target/mist/syn/sdram_clk.sdc
set_input_delay -clock SDRAM_CLK -max 6 [get_ports SDRAM_DQ[*]]
set_input_delay -clock SDRAM_CLK -min 3 [get_ports SDRAM_DQ[*]]

#**************************************************************
# Set Output Delay
#**************************************************************

set_output_delay -add_delay -max -clock SPI_SCK  6.4 [get_ports SPI_DO]
set_output_delay -add_delay -min -clock SPI_SCK  3.2 [get_ports SPI_DO]

# SDRAM tDS/tDH, from target/mist/syn/sdram_clk.sdc
set_output_delay -clock SDRAM_CLK -max 1.5 \
    [get_ports {SDRAM_A[*] SDRAM_BA[*] SDRAM_CKE SDRAM_DQMH SDRAM_DQML \
                SDRAM_DQ[*] SDRAM_nCAS SDRAM_nCS SDRAM_nRAS SDRAM_nWE}]
set_output_delay -clock SDRAM_CLK -min -0.8 \
    [get_ports {SDRAM_A[*] SDRAM_BA[*] SDRAM_CKE SDRAM_DQMH SDRAM_DQML \
                SDRAM_DQ[*] SDRAM_nCAS SDRAM_nCS SDRAM_nRAS SDRAM_nWE}]

set_false_path -to [get_keepers {*|jtframe_sync:*|synchronizer[*].s[0]}]

#**************************************************************
# Set Multicycle Path
#**************************************************************

# From target/mist/syn/sdram_clk.sdc
set_multicycle_path -hold -end -from [get_clocks {SDRAM_CLK}] -to [get_clocks {u_clocks|u_pll_game|altpll_component|auto_generated|pll1|clk[1]}] 2

set_multicycle_path -setup -end -from [get_keepers {SDRAM_DQ[*]}] -to [get_keepers {jtframe_mist:u_frame|jtframe_board:u_board|jtframe_sdram64:u_sdram|dout[*]}] 2
