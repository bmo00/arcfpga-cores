<misterromdescription>
    <about author="jotego" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>horizontal</rotation>
    <name>M.I.A.: Missing in Action (Japan, version R)</name>
    <setname>miaj</setname>
    <mameversion>0282</mameversion>
    <year>1989</year>
    <manufacturer>Konami</manufacturer>
    <players>2</players>
    <rbf>jttwin16</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="miaj.zip|mia.zip" md5="None" asm_md5="43ab82524519614a2635b2d5a2c119f6">
        <!--  -->
        <part>
            00 00 00 00 00 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x40000 (18 bits) -->
        <interleave output="16">
            <part name="808_r04.4n" crc="f1c8c597" map="01"/>
            <part name="808_r05.6n" crc="91fd83f4" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="808_r08.4r" crc="26f21704" map="01"/>
            <part name="808_r09.6r" crc="f74d4467" map="10"/>
        </interleave>
        <!-- JTFRAME_BA1_START -->
        <!-- sub - starts at 0x40000 - length 0x60000 (19 bits) -->
        <interleave output="16">
            <part name="808_e06.8n" crc="8f576b33" map="01"/>
            <part name="808_e07.10n" crc="297bdcea" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="808_e12.8s" crc="d62f1fde" map="01"/>
            <part name="808_e13.10s" crc="1fa708f4" map="10"/>
        </interleave>
        <part repeat="0x20000"> FF</part>
        <!-- GFX_START -->
        <!-- gfxrom - starts at 0xA0000 - length 0x200000 (21 bits) -->
        <interleave output="32">
            <part name="808d15.p13" crc="2b22a6b6" map="0021"/>
            <part name="808d17.p16" crc="d1299082" map="2100"/>
        </interleave>
        <part repeat="0x100000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- fixed - starts at 0x2A0000 - length 0x48000 (19 bits) -->
        <part name="808_e14.d8" crc="b9d36525"/>
        <part repeat="0x44000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- audiocpu - starts at 0x2E8000 - length 0x8000 (15 bits) -->
        <part name="808_e03.10a" crc="3d93a7cd"/>
        <!-- PCM_START -->
        <!-- k007232 - starts at 0x2F0000 - length 0x20000 (17 bits) -->
        <part name="808_d01.5a" crc="fd4d37c0"/>
        <!-- UPD_START -->
        <!-- upd - starts at 0x310000 -->
        <!-- Total 0x310000 bytes - 3136 kBytes -->
    </rom>
    <nvram index="2" size="315404"/>
    <!-- 8-pxl black frame on sides. -->
    <rom index="1">
        <part>20 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="20" default="ff,5e,ff">
        <DSW1/>
        <dip name="Coin A" bits="0,3" ids="Free Play,4/3,4/1,3/4,3/2,3/1,2/5,2/3,2/1,1/7,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <dip name="Coin B" bits="4,7" ids="Invalid,4/3,4/1,3/4,3/2,3/1,2/5,2/3,2/1,1/7,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <DSW2/>
        <dip name="Lives" bits="8,9" ids="7,5,3,2"/>
        <dip name="Bonus Life" bits="11,12" ids="100K Only,50K Only,50K Every 100K,30K Every 80K"/>
        <dip name="Difficulty" bits="13,14" ids="Very Difficult,Difficult,Normal,Easy"/>
        <dip name="Demo Sounds" bits="15" ids="On,Off"/>
        <DSW3/>
        <dip name="Flip Screen" bits="16" ids="On,Off"/>
        <dip name="Service Mode" bits="18" ids="On,Off"/>
    </switches>
    <buttons names="Knife, Weapon, Weapon select,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
