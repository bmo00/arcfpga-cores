JTFRAME_RELEASE=1
CORENAME=SPLASH
GAMETOP=jtsplash_game_sdram

# Core no oficial: el OSD muestra SPLASH, sin el prefijo JT, sin logo ni creditos JT
JTFRAME_OSD_NAME=SPLASH
JTFRAME_OSD_NOLOGO
JTFRAME_OSD_NOCREDITS

JTFRAME_PXLCLK=8
JTFRAME_JOY_LRDU

JTFRAME_COLORW=5
JTFRAME_WIDTH=368
JTFRAME_HEIGHT=240
JTFRAME_BUTTONS=2

# vram0 8kB + vram1 8kB + pal 4kB + oram 4kB + pxl 256kB
JTFRAME_IOCTL_RD=286720

# bank 0: maincpu 4MB (256kB program + FF gap + 3MB bitmap data)
JTFRAME_BA1_START=0x400000
JTFRAME_BA2_START=0x480000

[mist|sidi]
JTFRAME_NOSTA
