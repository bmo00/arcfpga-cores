<misterromdescription>
    <about author="blswhstl" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>vertical (cw)</rotation>
    <name>Bells &amp; Whistles (Asia, version M)</name>
    <setname>blswhstla</setname>
    <mameversion>0289</mameversion>
    <year>1991</year>
    <manufacturer>Konami</manufacturer>
    <players>2</players>
    <rbf>blswhstl</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="blswhstla.zip|blswhstl.zip" md5="None" address="0x30000000" asm_md5="5cc783731fd9a72c19c5b5a2cb120b08">
        <!-- Offsets for each ROM region. -->
        <part>
            00 00 80 00 90 01 90 02
            FF FF 00 00 00 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="060_m03.g09" crc="7b6ee4a4" map="01"/>
            <part name="060_m02.e09" crc="bc9dd08f" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="060_m10.g11" crc="f738ad4a" map="01"/>
            <part name="060_m09.e11" crc="14628736" map="10"/>
        </interleave>
        <!-- audiocpu - starts at 0x80000 - length 0x10000 (16 bits) -->
        <part name="060j01.f3" crc="f9d9a673"/>
        <!-- pcm - starts at 0x90000 - length 0x100000 (20 bits) -->
        <part name="060e04.d1" crc="c680395d"/>
        <!-- k052109 - starts at 0x190000 - length 0x100000 (20 bits) -->
        <interleave output="32">
            <part name="060e07.k16" crc="c400edf3" map="0021"/>
            <part name="060e08.k12" crc="70dddba1" map="2100"/>
        </interleave>
        <!-- obj - starts at 0x290000 - length 0x100000 (20 bits) -->
        <interleave output="32">
            <part name="060e06.k7" crc="09381492" map="0021"/>
            <part name="060e05.k3" crc="32454241" map="2100"/>
        </interleave>
        <!-- Total 0x390000 bytes - 3648 kBytes -->
    </rom>
