<misterromdescription>
    <about author="jotego" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>horizontal</rotation>
    <name>Escape Kids (Japan, 2 Players)</name>
    <setname>esckidsj</setname>
    <mameversion>0282</mameversion>
    <year>1991</year>
    <manufacturer>Konami</manufacturer>
    <players>2</players>
    <rbf>jtsimson</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="esckidsj.zip|esckids.zip" md5="None" address="0x30000000" asm_md5="35ec73d3b7f2205ab702e7e5cc4e1a42">
        <!--  Header to identify the PCB type
        Byte 0 = 0 - The Simpsons
                 1 - Reserved (Parodius)
                 2 - Vendetta -->
        <part>
            00 00 00 00 </part>
        <!-- maincpu - starts at 0x0 - length 0x80000 (19 bits) -->
        <part name="975r01" crc="7b5c5572"/>
        <part repeat="0x60000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- audiocpu - starts at 0x80000 - length 0x20000 (17 bits) -->
        <part name="975f02" crc="994fb229"/>
        <part repeat="0x10000"> FF</part>
        <!-- PCM_START -->
        <!-- pcm - starts at 0xA0000 - length 0x140000 (21 bits) -->
        <part name="975c03" crc="dc4a1707"/>
        <part repeat="0xC0000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- tiles - starts at 0x1E0000 - length 0x100000 (20 bits) -->
        <interleave output="32">
            <part name="975c09" crc="bc52210e" map="0021"/>
            <part name="975c08" crc="fcff9256" map="2100"/>
        </interleave>
        <!-- JTFRAME_BA3_START -->
        <!-- obj - starts at 0x2E0000 - length 0x400000 (22 bits) -->
        <interleave output="64">
            <part name="975c04" crc="15688a6f" map="00000021"/>
            <part name="975c05" crc="1ff33bb7" map="00002100"/>
            <part name="975c06" crc="36d410f9" map="00210000"/>
            <part name="975c07" crc="97ec541e" map="21000000"/>
        </interleave>
        <!-- Total 0x6E0000 bytes - 7040 kBytes -->
    </rom>
    <nvram index="2" size="28833"/>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <buttons names="button 1,button 2,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
