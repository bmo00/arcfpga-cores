<misterromdescription>
    <about author="snk-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>horizontal</rotation>
    <name>Mechanized Attack (US)</name>
    <setname>mechattu</setname>
    <mameversion>0289</mameversion>
    <year>1989</year>
    <manufacturer>SNK</manufacturer>
    <players>2</players>
    <rbf>mechatt</rbf>
    <joystick/>
    <region>World</region>
    <rom index="0" zip="mechattu.zip|mechatt.zip" md5="None" asm_md5="772bb5c1046c42c870be6ba0cd0aad24">
        <!-- maincpu - starts at 0x0 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="ma4u.l12" crc="09fa31ec" map="01"/>
            <part name="ma5u.n12" crc="485ea606" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="ma6u.l13" crc="d5d68ce6" map="01"/>
            <part name="ma7u.n13" crc="f45b2c70" map="10"/>
        </interleave>
        <!-- SND_START -->
        <!-- audiocpu - starts at 0x80000 - length 0x10000 (16 bits) -->
        <part name="ma_3.e13" crc="c06cc8e1"/>
        <!-- JTFRAME_BA1_START -->
        <!-- tx_tiles - starts at 0x90000 - length 0x20000 (17 bits) -->
        <part name="ma_1.l2" crc="24766917"/>
        <part repeat="0x10000"> FF</part>
        <!-- BG1_START -->
        <!-- bg1_tiles - starts at 0xB0000 - length 0x80000 (19 bits) -->
        <part name="mab189a2.bin" crc="e1c8b4d0"/>
        <!-- BG2_START -->
        <!-- bg2_tiles - starts at 0x130000 - length 0x80000 (19 bits) -->
        <part name="mab289c2.bin" crc="14f97ceb"/>
        <!-- JTFRAME_BA2_START -->
        <!-- sprites - starts at 0x1B0000 - length 0x200000 (21 bits) -->
        <part name="mao89p13.bin" crc="8bcb16cf"/>
        <part name="ma189p15.bin" crc="b84d9658"/>
        <part name="ma289p17.bin" crc="6cbe08ac"/>
        <part name="ma389m15.bin" crc="34d4585e"/>
        <!-- JTFRAME_BA3_START -->
        <!-- ymsnd - starts at 0x3B0000 - length 0x22000 (18 bits) -->
        <part name="ma_2.d10" crc="ea4cc30d"/>
        <part repeat="0x2000"> FF</part>
        <!-- JTFRAME_PROM_START -->
        <!-- sprites:scale_table - starts at 0x3D2000 - length 0x10000 (16 bits) -->
        <part name="ma_8.f10" crc="61f3de03"/>
        <!-- Total 0x3E2000 bytes - 3976 kBytes -->
    </rom>
    <!-- Light gun -->
    <rom index="1">
        <part>02 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ff">
        <DSW1/>
        <dip name="Allow Continue" bits="1" ids="No,Yes"/>
        <dip name="Magazine / Grenade" bits="2,3" ids="8 / 5,7 / 4,5 / 2,6 / 3"/>
        <dip name="Coinage" bits="4,5" ids="Free Play,1/2 first then 1/1,2/1 first then 1/1,1/1"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Game Mode" bits="10,11" ids="Freeze,Infinite Energy,Demo Sounds Off,Demo Sounds On"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Disparo,Granada,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
