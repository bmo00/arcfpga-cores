<misterromdescription>
    <about author="konami-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>horizontal</rotation>
    <name>Mystic Warriors (ver EAA)</name>
    <setname>mystwarr</setname>
    <mameversion>0289</mameversion>
    <year>1993</year>
    <manufacturer>Konami</manufacturer>
    <players>4</players>
    <rbf>mystwarr</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="mystwarr.zip" md5="None" address="0x30000000" asm_md5="aa282fd9a09d286288b5c640e440730f">
        <!-- Offsets for each ROM region. -->
        <part>
            00 00 00 02 40 06 C0 08
            FF FF 00 00 00 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x200000 (21 bits) -->
        <interleave output="16">
            <part name="128eaa02.20g" crc="f8ffa352" map="01"/>
            <part name="128eaa01.20f" crc="508f249c" map="10"/>
        </interleave>
        <part repeat="0x80000"> FF</part>
        <interleave output="16">
            <part name="128a04.19g" crc="88c6a3e4" map="01"/>
            <part name="128a03.19f" crc="e98094f3" map="10"/>
        </interleave>
        <!-- JTFRAME_BA1_START -->
        <!-- soundcpu - starts at 0x200000 - length 0x40000 (18 bits) -->
        <part name="128a05.6b" crc="0e5194e0"/>
        <part name="128a05.6b" crc="0e5194e0"/>
        <!-- PCM_START -->
        <!-- pcm - starts at 0x240000 - length 0x400000 (22 bits) -->
        <part name="128a06.2d" crc="88ed598c"/>
        <part name="128a07.1d" crc="db79a66e"/>
        <!-- JTFRAME_BA2_START -->
        <!-- k056832 - starts at 0x640000 - length 0x200000 (21 bits) -->
        <interleave output="32">
            <part name="128a08.1h" crc="63d6cfa0" map="0012" length="0x100000"/>
            <part name="128a09.1k" crc="573a7725" map="1200" length="0x100000"/>
        </interleave>
        <!-- scrx - starts at 0x840000 - length 0x80000 (19 bits) -->
        <part name="128a10.3h" crc="558e545a"/>
        <!-- JTFRAME_BA3_START -->
        <!-- obj - starts at 0x8C0000 - length 0x400000 (22 bits) -->
        <interleave output="64">
            <part name="128a16.22k" crc="459b6407" map="00000021"/>
            <part name="128a15.20k" crc="6bbfedf4" map="00002100"/>
            <part name="128a14.19k" crc="f7bd89dd" map="00210000"/>
            <part name="128a13.17k" crc="e89b66a2" map="21000000"/>
        </interleave>
        <!-- objx - starts at 0xCC0000 - length 0x100000 (20 bits) -->
        <interleave output="16">
            <part name="128a12.12k" crc="63de93e2" map="01"/>
            <part name="128a11.10k" crc="4eac941a" map="10"/>
        </interleave>
        <!-- Total 0xDC0000 bytes - 14080 kBytes -->
    </rom>
