    <switches page_id="1" page_name="Switches" base="16" default="ff,73">
        <DSW1/>
        <dip name="Coin A" bits="0,3" ids="Free Play,5/3,5/1,4/3,4/1,3/4,3/2,3/1,2/5,2/3,2/1,1/5,1/4,1/3,1/2,1/1"/>
