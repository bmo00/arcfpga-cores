        <dip name="Driving Technique" bits="10" ids="High Technique Required,Normal"/>
        <dip name="Difficulty" bits="11,12" ids="Very Difficult,Difficult,Normal,Easy"/>
        <dip name="Steering and Seat Vibration" bits="13" ids="On,Off"/>
        <dip name="Demo Sounds" bits="15" ids="On,Off"/>
    </switches>
