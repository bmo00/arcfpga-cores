<misterromdescription>
    <about author="snk-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>vertical (ccw)</rotation>
    <name>T.N.K III (US)</name>
    <setname>tnk3</setname>
    <mameversion>0289</mameversion>
    <year>1985</year>
    <manufacturer>SNK</manufacturer>
    <players>2</players>
    <rbf>gwar</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="tnk3.zip" md5="None" asm_md5="985074e145365622ece9807a5d5e3700">
        <!-- maincpu - starts at 0x0 - length 0x10000 (16 bits) -->
        <part name="p1.4e" crc="0d2a8ca9"/>
        <part name="p2.4f" crc="0ae0a483"/>
        <part name="p3.4h" crc="d16dd4db"/>
        <part repeat="0x4000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- sub - starts at 0x10000 - length 0x10000 (16 bits) -->
        <part name="p4.2e" crc="01b45a90"/>
        <part name="p5.2f" crc="60db6667"/>
        <part name="p6.2h" crc="4761fde7"/>
        <part repeat="0x4000"> FF</part>
        <!-- PCM_START -->
        <!-- ym2 - starts at 0x20000 - length 0x10000 (16 bits) -->
        <part repeat="0x10000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- audiocpu - starts at 0x30000 - length 0x10000 (16 bits) -->
        <part name="p10.6f" crc="7bf0a517"/>
        <part name="p11.6d" crc="0569ce27"/>
        <part repeat="0x8000"> FF</part>
        <!-- BG_START -->
        <!-- bg_tiles - starts at 0x40000 - length 0x40000 (18 bits) -->
        <part name="p12.3d" crc="ff495a16"/>
        <part name="p13.3c" crc="f8344843"/>
        <part repeat="0x38000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- sp16_tiles - starts at 0x80000 - length 0x40000 (18 bits) -->
        <interleave output="32">
            <part name="p7.7h" crc="06b92c88" map="0001"/>
            <part name="p8.7f" crc="63d0e2eb" map="0010"/>
            <part name="p9.7e" crc="872e3fac" map="0100"/>
            <part name="p9.7e" crc="872e3fac" map="1000"/>
        </interleave>
        <part repeat="0x30000"> FF</part>
        <!-- SP32_START -->
        <!-- sp32_tiles - starts at 0xC0000 - length 0x80000 (19 bits) -->
        <part repeat="0x80000"> FF</part>
        <!-- JTFRAME_PROM_START -->
        <!-- tx_tiles - starts at 0x140000 - length 0x2000 (13 bits) -->
        <part name="p14.1e" crc="1fd18c43"/>
        <!-- proms - starts at 0x142000 - length 0xC00 (12 bits) -->
        <part name="2.5f" crc="34c06bc6"/>
        <part name="1.5g" crc="6d0ac66a"/>
        <part name="0.5h" crc="4662b4c8"/>
        <!-- Total 0x142C00 bytes - 1291 kBytes -->
    </rom>
    <!-- Vertical screen. Orientation reversed. -->
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fb,bb">
        <BONUS/>
        <dip name="Bonus Life" bits="0" ids="None,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,50k 120k,50k 120k 120k+,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,40k 90k,40k 90k 90k+,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,20k 60k,20k 60k 60k+"/>
        <DSW1/>
        <dip name="No BG Collision (Cheat)" bits="1" ids="On,Off"/>
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="3" ids="5,3"/>
        <dip name="Coinage" bits="4,6" ids="Free Play,-,-,2/1,3/1,1/3,1/2,1/1"/>
        <DSW2/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Normal,Easy"/>
        <dip name="Game Mode" bits="10,11" ids="Freeze,Infinite Lives,Demo Sounds On,Demo Sounds Off"/>
        <dip name="Flip Screen" bits="12" ids="On,Off"/>
        <dip name="Allow Continue" bits="14" ids="5 Times,No"/>
    </switches>
    <buttons names="button 1,button 2,-,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
