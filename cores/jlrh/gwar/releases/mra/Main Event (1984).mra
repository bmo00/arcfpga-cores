<misterromdescription>
    <about author="snk-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>horizontal</rotation>
    <name>Main Event (1984)</name>
    <setname>mainsnk</setname>
    <mameversion>0289</mameversion>
    <year>1984</year>
    <manufacturer>SNK</manufacturer>
    <players>2</players>
    <rbf>gwar</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="mainsnk.zip" md5="None">
        <!-- maincpu - starts at 0x0 - length 0x10000 (16 bits) -->
        <part name="snk.p01" crc="00db1ca2"/>
        <part name="snk.p02" crc="df5c86b5"/>
        <part name="snk.p03" crc="5c2b7bca"/>
        <part name="snk.p04" crc="68b4b2a1"/>
        <part name="snk.p05" crc="580a29b4"/>
        <part name="snk.p06" crc="5f8a60a2"/>
        <part repeat="0x4000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- sub - starts at 0x10000 - length 0x10000 (16 bits) -->
        <part repeat="0x10000"> FF</part>
        <!-- PCM_START -->
        <!-- ym2 - starts at 0x20000 - length 0x10000 (16 bits) -->
        <part repeat="0x10000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- audiocpu - starts at 0x30000 - length 0x10000 (16 bits) -->
        <part name="snk.p07" crc="4208391e"/>
        <part repeat="0xC000"> FF</part>
        <!-- BG_START -->
        <!-- bg_tiles - starts at 0x40000 - length 0x40000 (18 bits) -->
        <part repeat="0x40000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- sp16_tiles - starts at 0x80000 - length 0x40000 (18 bits) -->
        <part repeat="0x40000"> FF</part>
        <!-- SP32_START -->
        <!-- sp32_tiles - starts at 0xC0000 - length 0x80000 (19 bits) -->
        <part repeat="0x80000"> FF</part>
        <!-- JTFRAME_PROM_START -->
        <!-- tx_tiles - starts at 0x140000 -->
        <!-- proms - starts at 0x140000 - length 0x1800 (13 bits) -->
        <part name="main3.bin" crc="78b29dde"/>
        <part name="main2.bin" crc="7c314c93"/>
        <part name="main1.bin" crc="deb895c4"/>
        <!-- sprites - starts at 0x141800 - length 0x12000 (17 bits) -->
        <part name="snk.p13" crc="2eb624a4"/>
        <part name="snk.p16" crc="dc502869"/>
        <part name="snk.p19" crc="58d566a1"/>
        <part name="snk.p14" crc="bb927d82"/>
        <part name="snk.p17" crc="66f60c32"/>
        <part name="snk.p20" crc="d12c6333"/>
        <part name="snk.p15" crc="d242486d"/>
        <part name="snk.p18" crc="838b12a3"/>
        <part name="snk.p21" crc="8961a51e"/>
        <!-- tiles - starts at 0x153800 - length 0x8000 (15 bits) -->
        <part name="snk.p12" crc="ecf87eb7"/>
        <part name="snk.p11" crc="3f6bc5ba"/>
        <part name="snk.p10" crc="b5147a96"/>
        <part name="snk.p09" crc="0ebcf837"/>
        <!-- Total 0x15B800 bytes - 1390 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,bf">
        <DSW1/>
        <DSW2/>
        <dip name="Coinage" bits="8,10" ids="Free Play,3/1,3/1,1/2,3/1,1/3,2/1,1/1"/>
        <dip name="Difficulty" bits="11" ids="Hard,Easy"/>
        <dip name="Round Time" bits="12" ids="Short,Normal"/>
        <dip name="Game mode" bits="13,14" ids="Freeze,Demo Sounds On,Endless Game,Demo Sounds Off"/>
        <dip name="2 Players Game" bits="15" ids="2,1"/>
    </switches>
    <buttons names="button 1,button 2,-,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
