<misterromdescription>
    <about author="snk-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>vertical (ccw)</rotation>
    <name>ASO - Armored Scrum Object</name>
    <setname>aso</setname>
    <mameversion>0289</mameversion>
    <year>1985</year>
    <manufacturer>SNK</manufacturer>
    <players>2</players>
    <rbf>gwar</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="aso.zip" md5="None" asm_md5="e80ec31a4c95415d5f0fae39b9e3971f">
        <!-- maincpu - starts at 0x0 - length 0x10000 (16 bits) -->
        <part name="p1.8d" crc="84981f3c"/>
        <part name="p2.7d" crc="cfe912a6"/>
        <part name="p3.5d" crc="39a666d2"/>
        <part repeat="0x4000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- sub - starts at 0x10000 - length 0x10000 (16 bits) -->
        <part name="p4.3d" crc="a4122355"/>
        <part name="p5.2d" crc="9879e506"/>
        <part name="p6.1d" crc="c0bfdf1f"/>
        <part repeat="0x4000"> FF</part>
        <!-- PCM_START -->
        <!-- ym2 - starts at 0x20000 - length 0x10000 (16 bits) -->
        <part repeat="0x10000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- audiocpu - starts at 0x30000 - length 0x10000 (16 bits) -->
        <part name="p7.4f" crc="dbc19736"/>
        <part name="p8.3f" crc="537726a9"/>
        <part name="p9.2f" crc="aef5a4f4"/>
        <part repeat="0x4000"> FF</part>
        <!-- BG_START -->
        <!-- bg_tiles - starts at 0x40000 - length 0x40000 (18 bits) -->
        <part name="p10.14h" crc="00dff996"/>
        <part repeat="0x38000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- sp16_tiles - starts at 0x80000 - length 0x40000 (18 bits) -->
        <interleave output="32">
            <part name="p11.11h" crc="7feac86c" map="0001"/>
            <part name="p12.9h" crc="6895990b" map="0010"/>
            <part name="p13.8h" crc="87a81ce1" map="0100"/>
            <part name="p13.8h" crc="87a81ce1" map="1000"/>
        </interleave>
        <part repeat="0x20000"> FF</part>
        <!-- SP32_START -->
        <!-- sp32_tiles - starts at 0xC0000 - length 0x80000 (19 bits) -->
        <part repeat="0x80000"> FF</part>
        <!-- JTFRAME_PROM_START -->
        <!-- tx_tiles - starts at 0x140000 - length 0x2000 (13 bits) -->
        <part name="p14.1h" crc="8baa2253"/>
        <!-- proms - starts at 0x142000 - length 0xC00 (12 bits) -->
        <part name="mb7122h.12f" crc="5b0a0059"/>
        <part name="mb7122h.13f" crc="37e28dd8"/>
        <part name="mb7122h.14f" crc="c3fd1dd3"/>
        <!-- plds - starts at 0x142C00 - length 0x504 (11 bits) -->
        <part name="pal16l8a-1.bin" crc="4e3f9e0d"/>
        <part repeat="0xFC"> FF</part>
        <part name="pal16l8a-2.bin" crc="2a681f9e"/>
        <part repeat="0xFC"> FF</part>
        <part name="pal16r6a.15b" crc="59c03681"/>
        <!-- Total 0x143104 bytes - 1292 kBytes -->
    </rom>
    <!-- Vertical screen. Orientation reversed. -->
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="f9,fb">
        <BONUS/>
        <dip name="Bonus Life" bits="0" ids="None,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,100k 200k,100k 200k 200k+,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,60k 120k,60k 120k 120k+,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,-,50k 100k,50k 100k 100k+"/>
        <DSW1/>
        <dip name="Allow Continue" bits="1" ids="3 Times,No"/>
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="3" ids="5,3"/>
        <dip name="Coinage" bits="4,6" ids="1/6,1/4,1/3,1/2,4/1,3/1,2/1,1/1"/>
        <DSW2/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Normal,Easy"/>
        <dip name="Demo Sounds" bits="10" ids="On,Off"/>
        <dip name="All Ships at Start (Cheat)" bits="11" ids="On,Off"/>
        <dip name="Flip Screen" bits="12" ids="On,Off"/>
        <dip name="Start Area" bits="13,14" ids="4,3,2,1"/>
    </switches>
    <buttons names="button 1,button 2,-,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
