<misterromdescription>
    <about author="snk-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>horizontal</rotation>
    <name>Mad Crusher (Japan)</name>
    <setname>madcrush</setname>
    <mameversion>0289</mameversion>
    <year>1984</year>
    <manufacturer>SNK</manufacturer>
    <players>2</players>
    <rbf>gwar</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="madcrush.zip|madcrash.zip" md5="None" asm_md5="2e24dc736eb18413db9fc788aeb564cb">
        <!-- maincpu - starts at 0x0 - length 0x10000 (16 bits) -->
        <part name="p3.a8" crc="fbd3eda1"/>
        <part name="p4.a9" crc="1bc67cab"/>
        <part name="p5.a10" crc="d905ff79"/>
        <part repeat="0xA000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- sub - starts at 0x10000 - length 0x10000 (16 bits) -->
        <part name="p6.a11" crc="432b5743"/>
        <part name="p7.a13" crc="dea2865a"/>
        <part name="p8.a14" crc="e25a9b9c"/>
        <part name="p10.bin" crc="55b14a36"/>
        <part name="p9.bin" crc="e3c8c2cb"/>
        <part repeat="0x6000"> FF</part>
        <!-- PCM_START -->
        <!-- ym2 - starts at 0x20000 - length 0x10000 (16 bits) -->
        <part repeat="0x10000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- audiocpu - starts at 0x30000 - length 0x10000 (16 bits) -->
        <part name="p1.a6" crc="2dcd036d"/>
        <part name="p2.a8" crc="cc30ae8b"/>
        <part repeat="0xC000"> FF</part>
        <!-- BG_START -->
        <!-- bg_tiles - starts at 0x40000 - length 0x40000 (18 bits) -->
        <part name="p12.c2" crc="085094c1"/>
        <part repeat="0x3E000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- sp16_tiles - starts at 0x80000 - length 0x40000 (18 bits) -->
        <interleave output="32">
            <part name="p16.k4" crc="6153611a" map="0001"/>
            <part name="p15.k2" crc="a74149d4" map="0010"/>
            <part name="p14.k1" crc="07e807bc" map="0100"/>
            <part name="p14.k1" crc="07e807bc" map="1000"/>
        </interleave>
        <part repeat="0x38000"> FF</part>
        <!-- SP32_START -->
        <!-- sp32_tiles - starts at 0xC0000 - length 0x80000 (19 bits) -->
        <part repeat="0x80000"> FF</part>
        <!-- JTFRAME_PROM_START -->
        <!-- tx_tiles - starts at 0x140000 - length 0x2000 (13 bits) -->
        <part name="p13.e2" crc="fcdd36ca"/>
        <!-- proms - starts at 0x142000 - length 0xC00 (12 bits) -->
        <part name="m3-prom.j3" crc="d19e8a91"/>
        <part name="m2-prom.j4" crc="9fc325af"/>
        <part name="m1-prom.j5" crc="07678443"/>
        <!-- fg_tiles - starts at 0x142C00 - length 0x2000 (13 bits) -->
        <part name="p11.a2" crc="67174956"/>
        <!-- Total 0x144C00 bytes - 1299 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fd,f4">
        <DSW1/>
        <dip name="Cabinet" bits="1" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="2" ids="5,3"/>
        <dip name="Coinage" bits="3,5" ids="Free Play,-,5/1,2/1,3/1,1/3,1/2,1/1"/>
        <dip name="Bonus Life" bits="6,7" ids="None,50k 120k,40k 90k,20k 60k"/>
        <DSW2/>
        <dip name="Bonus Life Occurrence" bits="8" ids="1st and 2nd only,1st 2nd then every 2nd"/>
        <dip name="Scroll Speed" bits="9,10" ids="Faster,Fast,Normal,Slow"/>
        <dip name="Game mode" bits="11,12" ids="Freeze,Infinite Lives,Demo Sounds On,Demo Sounds Off"/>
        <dip name="Flip Screen" bits="13" ids="On,Off"/>
        <dip name="Difficulty" bits="14" ids="Hard,Easy"/>
    </switches>
    <buttons names="button 1,button 2,-,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
