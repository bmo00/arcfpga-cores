<misterromdescription>
    <about author="snk-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>vertical (ccw)</rotation>
    <name>Koukuu Kihei Monogatari - The Legend of Air Cavalry (Japan)</name>
    <setname>legofair</setname>
    <mameversion>0289</mameversion>
    <year>1988</year>
    <manufacturer>SNK</manufacturer>
    <players>2</players>
    <rbf>gwar</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="legofair.zip|chopper.zip" md5="None" asm_md5="852b929a3b50a6803dc7bf9e3a282674">
        <!-- maincpu - starts at 0x0 - length 0x10000 (16 bits) -->
        <part name="kk1.4m" crc="79a485c0"/>
        <!-- JTFRAME_BA1_START -->
        <!-- sub - starts at 0x10000 - length 0x10000 (16 bits) -->
        <part name="kk4.8m" crc="96d3a4d9"/>
        <!-- PCM_START -->
        <!-- ym2 - starts at 0x20000 - length 0x10000 (16 bits) -->
        <part name="kk2.5b" crc="06169ae0"/>
        <!-- JTFRAME_BA2_START -->
        <!-- audiocpu - starts at 0x30000 - length 0x10000 (16 bits) -->
        <part name="kk3.6j" crc="dbaafb87"/>
        <!-- BG_START -->
        <!-- bg_tiles - starts at 0x40000 - length 0x40000 (18 bits) -->
        <part name="kk10.1a" crc="5cf4d22b"/>
        <part name="kk11.1b" crc="9af4cad0"/>
        <part name="kk12.1d" crc="02fec778"/>
        <part name="kk13.1e" crc="2756817d"/>
        <!-- JTFRAME_BA3_START -->
        <!-- sp16_tiles - starts at 0x80000 - length 0x40000 (18 bits) -->
        <interleave output="32">
            <part name="kk9.3g" crc="653c4342" map="0001"/>
            <part name="kk8.3e" crc="2da45894" map="0010"/>
            <part name="kk7.3d" crc="a0ebebdf" map="0100"/>
            <part name="kk6.3b" crc="284fad9e" map="1000"/>
        </interleave>
        <part repeat="0x20000"> FF</part>
        <!-- SP32_START -->
        <!-- sp32_tiles - starts at 0xC0000 - length 0x80000 (19 bits) -->
        <interleave output="32">
            <part name="kk18.8m" crc="6abbff36" map="0001"/>
            <part name="kk20.8p" crc="6403ddf2" map="0010"/>
            <part name="kk14.7p" crc="9bad9e25" map="0100"/>
            <part name="kk16.8j" crc="efb1fb6c" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="kk19.8n" crc="5283b4d3" map="0001"/>
            <part name="kk21.8s" crc="9f411940" map="0010"/>
            <part name="kk15.7s" crc="89faf590" map="0100"/>
            <part name="kk17.8k" crc="6b7fb0a5" map="1000"/>
        </interleave>
        <!-- JTFRAME_PROM_START -->
        <!-- tx_tiles - starts at 0x140000 - length 0x8000 (15 bits) -->
        <part name="kk5.3a" crc="defc0987"/>
        <!-- proms - starts at 0x148000 - length 0x1400 (13 bits) -->
        <part name="1.1k" crc="7f07a45c"/>
        <part name="2.1l" crc="15359fc3"/>
        <part name="3.2k" crc="79b50f7d"/>
        <part name="horizon.6h" crc="c20b197b"/>
        <part name="vertical.7h" crc="5d0c617f"/>
        <!-- plds - starts at 0x149400 -->
        <!-- Skipping region plds because there is no dump known -->
        <!-- Total 0x149400 bytes - 1317 kBytes -->
    </rom>
    <!-- Vertical screen. Orientation reversed. -->
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fb,f9,ff">
        <BONUS/>
        <dip name="Bonus Life" bits="2" ids="None,-,-,-,100k 200k 200k+,100k 200k,-,-,75k 150k 150k+,75k 150k,-,-,50k 100k 100k+,50k 100k"/>
        <DSW1/>
        <dip name="Flip Screen" bits="3" ids="On,Off"/>
        <dip name="Cabinet" bits="4" ids="Cocktail,Upright"/>
        <dip name="Lives" bits="6" ids="5,3"/>
        <dip name="Coin A" bits="7,8" ids="4/1,3/1,2/1,1/1"/>
        <dip name="Coin B" bits="9,10" ids="1/2,1/3,1/4,1/6"/>
        <DSW2/>
        <dip name="Difficulty" bits="11,12" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Game Mode" bits="13,14" ids="Freeze,Infinite Lives,Demo Sounds Off,Demo Sounds On"/>
        <dip name="Allow Continue" bits="17" ids="No,Yes"/>
        <dip name="Invulnerability (Cheat)" bits="18" ids="On,Off"/>
    </switches>
    <buttons names="button 1,button 2,-,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
