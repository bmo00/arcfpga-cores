<misterromdescription>
    <about author="jlrh" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>horizontal</rotation>
    <name>Konami RF2: Red Fighter (Bubble System)</name>
    <setname>bs_rf2</setname>
    <mameversion>0289</mameversion>
    <year>1985</year>
    <manufacturer>Konami</manufacturer>
    <players>1</players>
    <rbf>konamigt</rbf>
    <joystick/>
    <region>World</region>
    <rom index="0" zip="bs_rf2.zip" md5="None" asm_md5="09020dd084a3c9e8ed228097e307a63e">
        <!-- maincpu - starts at 0x0 - length 0x40000 (18 bits) -->
        <interleave output="16">
            <part name="boot.bin" crc="ee6e93d7" map="12"/>
        </interleave>
        <part repeat="0x3FE20"> FF</part>
        <!-- SND_START -->
        <!-- audiocpu - starts at 0x40000 - length 0x4000 (14 bits) -->
        <part name="400b03.8g" crc="85c2afc5"/>
        <part repeat="0x2000"> FF</part>
        <!-- JTFRAME_PROM_START -->
        <!-- k005289 - starts at 0x44000 - length 0x200 (9 bits) -->
        <part name="400a1.2b" crc="5827b1e8"/>
        <part name="400a2.1b" crc="2f44f970"/>
        <!-- bubblememory - starts at 0x44200 - length 0x48360 (19 bits) -->
        <part name="rf2b.bin" crc="7ee7acc5"/>
        <!-- Total 0x8C560 bytes - 561 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,6f,ff">
        <DSW0/>
        <dip name="Coin A" bits="0,3" ids="Free Play,4/3,4/1,3/4,3/2,3/1,2/5,2/3,2/1,1/7,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <dip name="Coin B" bits="4,7" ids="No B,4/3,4/1,3/4,3/2,3/1,2/5,2/3,2/1,1/7,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <DSW1/>
        <dip name="Difficulty" bits="12,13" ids="Hardest,Hard,Normal,Easy"/>
        <dip name="Demo Sounds" bits="15" ids="On,Off"/>
        <TEST/>
        <dip name="Flip Screen" bits="16" ids="On,Off"/>
        <dip name="Service Mode" bits="18" ids="On,Off"/>
    </switches>
    <buttons names="button 1,button 2,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
