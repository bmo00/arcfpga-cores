<misterromdescription>
    <about author="technos-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>horizontal</rotation>
    <name>Shadow Force - Henshin Ninja (Japan, Version 2)</name>
    <setname>shadfrcej</setname>
    <mameversion>0289</mameversion>
    <year>1993</year>
    <manufacturer>Technos Japan</manufacturer>
    <players>2</players>
    <rbf>shadfrce</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="shadfrcej.zip|shadfrce.zip" md5="None" asm_md5="6aa1e03ff404951f0a3bb26c458734d9">
        <!-- maincpu - starts at 0x0 - length 0x100000 (20 bits) -->
        <interleave output="16">
            <part name="32j12-01.34" crc="38fdbe1d" map="01"/>
            <part name="32j13-01.26" crc="6e1df6f1" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="32j14-01.33" crc="89e3fb60" map="01"/>
            <part name="32j15-01.14" crc="3dc3a84a" map="10"/>
        </interleave>
        <!-- JTFRAME_BA1_START -->
        <!-- tiles - starts at 0x100000 - length 0x300000 (22 bits) -->
        <part name="32j1-0.4" crc="f1cca740"/>
        <part name="32j2-0.5" crc="5fac3e01"/>
        <part name="32j3-0.6" crc="d297925e"/>
        <!-- SND_START -->
        <!-- audiocpu - starts at 0x400000 - length 0x10000 (16 bits) -->
        <part name="32j10-0.42" crc="65daf475"/>
        <!-- PCM_START -->
        <!-- oki - starts at 0x410000 - length 0x80000 (19 bits) -->
        <part name="32j9-0.76" crc="16001e81"/>
        <!-- CHAR_START -->
        <!-- chars - starts at 0x490000 - length 0x220000 (22 bits) -->
        <part name="32j11-0.55" crc="7252d993"/>
        <part repeat="0x200000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- sprites - starts at 0x6B0000 - length 0x800000 (23 bits) -->
        <interleave output="32">
            <part name="32j8-0.32" crc="201bebf6" map="0001" length="0x200000"/>
            <part name="32j7-0.25" crc="bcb37922" map="0010" length="0x200000"/>
            <part name="32j6-0.24" crc="6cde8ebe" map="0100" length="0x200000"/>
            <part name="32j5-0.13" crc="600026b5" map="1000" length="0x200000"/>
        </interleave>
        <!-- Total 0xEB0000 bytes - 15040 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fe,ff">
        <DSW1/>
        <dip name="Coinage" bits="1,2" ids="3/1,2/1,1/2,1/1"/>
        <dip name="Continue Price" bits="3" ids="On,Off"/>
        <dip name="Free Play" bits="4" ids="On,Off"/>
        <dip name="Flip Screen" bits="5" ids="On,Off"/>
        <dip name="Demo Sounds" bits="6" ids="Off,On"/>
        <dip name="Service Mode" bits="7" ids="On,Off"/>
        <DSW2/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Stage Clear Energy Regain" bits="10,11" ids="0%,25%,50%,100%"/>
        <dip name="Player&apos;s lives" bits="12" ids="1,2"/>
        <dip name="Vs. Stage" bits="13" ids="On,Off"/>
    </switches>
    <buttons names="Punch,Kick,Jump,-,-,-,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
