<misterromdescription>
    <about author="TODO" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>vertical (ccw)</rotation>
    <name>Aero Fighters (World / USA + Canada / Korea / Hong Kong / Taiwan) (newer hardware)</name>
    <setname>aerofgt</setname>
    <mameversion>0289</mameversion>
    <year>1992</year>
    <manufacturer>Video System Co.</manufacturer>
    <players>2</players>
    <rbf>aerofgt</rbf>
    <joystick>8</joystick>
    <region>Korea</region>
    <rom index="0" zip="aerofgt.zip" md5="None" asm_md5="e3469218dedeba86850634d3bca8beb5">
        <!-- maincpu - starts at 0x0 - length 0x80000 (19 bits) -->
        <part name="1.u4" crc="6fdff0a2"/>
        <!-- SND_START -->
        <!-- audiocpu - starts at 0x80000 - length 0x20000 (17 bits) -->
        <part name="2.153" crc="a1ef64ec"/>
        <!-- CHR_START -->
        <!-- JTFRAME_BA1_START -->
        <!-- tiles - starts at 0xA0000 - length 0x100000 (20 bits) -->
        <part name="538a54.124" crc="4d2c4df2"/>
        <part name="1538a54.124" crc="286d109e"/>
        <!-- OBJ_START -->
        <!-- JTFRAME_BA2_START -->
        <!-- sprites - starts at 0x1A0000 - length 0x180000 (21 bits) -->
        <part name="538a53.u9" crc="630d8e0b"/>
        <part name="534g8f.u18" crc="76ce0926"/>
        <!-- PCMB_START -->
        <!-- JTFRAME_BA3_START -->
        <!-- ymsnd:adpcmb - starts at 0x320000 - length 0x40000 (18 bits) -->
        <part name="it-19-01" crc="6d42723d"/>
        <!-- PCMA_START -->
        <!-- ymsnd:adpcma - starts at 0x360000 - length 0x100000 (20 bits) -->
        <part name="it-19-06" crc="cdbbdb1d"/>
        <!-- Total 0x460000 bytes - 4480 kBytes -->
    </rom>
    <!-- Vertical screen. Orientation reversed. -->
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,fd,f0">
        <DSW1/>
        <dip name="Coin Slot" bits="0" ids="Individual,Same"/>
        <dip name="Coin A" bits="1,3" ids="1/6,1/5,1/4,1/3,1/2,3/1,2/1,1/1"/>
        <dip name="Coin B" bits="4,6" ids="1/6,1/5,1/4,1/3,1/2,3/1,2/1,1/1"/>
        <dip name="Continue Coin" bits="7" ids="Start 2/Continue 1,Start 1/Continue 1"/>
        <DSW2/>
        <dip name="Flip Screen" bits="8" ids="On,Off"/>
        <dip name="Demo Sounds" bits="9" ids="On,Off"/>
        <dip name="Difficulty" bits="10,11" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Lives" bits="12,13" ids="4,2,1,3"/>
        <dip name="Bonus Life" bits="14" ids="300k,200k"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
        <JP1/>
        <dip name="Region" bits="16,19" ids="Any,-,-,-,-,-,-,-,-,-,-,Taiwan,-,Hong Kong,Korea,USA/Canada"/>
    </switches>
    <buttons names="Button 1,Button 2,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
