JTFRAME_RELEASE=1
CORENAME=MOMOKO
GAMETOP=jtmomoko_game_sdram

# Core no oficial: nombre visible del OSD sin el prefijo JT
# (CORENAME se mantiene intacto: los generadores dependen de el)
JTFRAME_OSD_NAME=MOMOKO
# sin logo de JT en el fondo del OSD ni pantalla de creditos
JTFRAME_OSD_NOLOGO
JTFRAME_OSD_NOCREDITS

JTFRAME_PXLCLK=6
JTFRAME_COLORW=4
JTFRAME_WIDTH=240
JTFRAME_HEIGHT=216
JTFRAME_BUTTONS=2

# vram 1kB + pal 1kB + oram 256B + vregs 16B + wram 4kB
JTFRAME_IOCTL_RD=6416

# layout del .rom (ver plan): BA0 main 48kB, BA1 snd 32kB, resto BRAM
# NB (H3): BA2_START=0x14000 marca donde termina snd/BA1 y empieza el
# bloque de BRAM ROM de graficos. Sin este limite, jtframe_dwnld deja
# `bank` clavado en 1 (BA1) para TODO lo que sigue tras 0xC000 (no hay
# donde mas ir sin un BA2_START), asi que bgmap/bggfx/objgfx/fgmap/
# chgfx/fggfx/bgatr/tprom nunca coincidian con su `rom: offset:` (escrito
# como byte plano) y quedaban sin datos reales (bug detectado al ver
# tprom_data siempre 0 pese a `-load` y descarga completa). Los offsets
# de esas 8 entradas en mem.yaml usan ahora la formula de bubl/mcu:
# ((`MOMOKO_X-`JTFRAME_BA2_START)>>1)|24'h800000 (bank=2 en bits[23:22]).
JTFRAME_BA1_START=0xC000
JTFRAME_BA2_START=0x14000
MOMOKO_BGMAP=0x14000
MOMOKO_BGGFX=0x34000
MOMOKO_OBJGFX=0x54000
MOMOKO_FGMAP=0x64000
MOMOKO_CHGFX=0x68000
MOMOKO_FGGFX=0x6A000
MOMOKO_BGATR=0x6C000
MOMOKO_PROM=0x6E000

[mist|sidi]
JTFRAME_NOSTA
