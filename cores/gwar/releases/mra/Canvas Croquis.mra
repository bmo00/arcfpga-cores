<misterromdescription>
    <about author="snk-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>horizontal</rotation>
    <name>Canvas Croquis</name>
    <setname>canvas</setname>
    <mameversion>0289</mameversion>
    <year>1985</year>
    <manufacturer>SNK</manufacturer>
    <players>2</players>
    <rbf>gwar</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="canvas.zip" md5="None">
        <!-- maincpu - starts at 0x0 - length 0x10000 (16 bits) -->
        <part name="cc_p1.a2" crc="fa7109e1"/>
        <part name="cc_p2.a3" crc="8b8beb34"/>
        <part name="cc_p3.a4" crc="ea342f87"/>
        <part name="cc_p4.a5" crc="9cf35d98"/>
        <part name="cc_p5.a7" crc="c5ef1eda"/>
        <part name="cc_p6.a8" crc="7b1dd7fc"/>
        <part repeat="0x4000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- sub - starts at 0x10000 - length 0x10000 (16 bits) -->
        <part repeat="0x10000"> FF</part>
        <!-- PCM_START -->
        <!-- ym2 - starts at 0x20000 - length 0x10000 (16 bits) -->
        <part repeat="0x10000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- audiocpu - starts at 0x30000 - length 0x10000 (16 bits) -->
        <part name="cc_p7.h2" crc="029b5ea0"/>
        <part name="cc_p8.f2" crc="0f0368ce"/>
        <part repeat="0xA000"> FF</part>
        <!-- BG_START -->
        <!-- bg_tiles - starts at 0x40000 - length 0x40000 (18 bits) -->
        <part repeat="0x40000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- sp16_tiles - starts at 0x80000 - length 0x40000 (18 bits) -->
        <part repeat="0x40000"> FF</part>
        <!-- SP32_START -->
        <!-- sp32_tiles - starts at 0xC0000 - length 0x80000 (19 bits) -->
        <part repeat="0x80000"> FF</part>
        <!-- JTFRAME_PROM_START -->
        <!-- tx_tiles - starts at 0x140000 -->
        <!-- proms - starts at 0x140000 - length 0xC00 (12 bits) -->
        <part name="cc_bprom3.j8" crc="21f72498"/>
        <part name="cc_bprom2.j9" crc="19efe7df"/>
        <part name="cc_bprom1.j10" crc="fbbbf911"/>
        <!-- sprites - starts at 0x140C00 - length 0x6000 (15 bits) -->
        <part name="cc_p12.j8" crc="9003a979"/>
        <part name="cc_p13.j5" crc="a52cd549"/>
        <part name="cc_p14.j2" crc="edc6a1e8"/>
        <!-- tiles - starts at 0x146C00 - length 0x10000 (16 bits) -->
        <part repeat="0x4000"> FF</part>
        <part name="cc_p11.c2" crc="4c8c2156"/>
        <part name="cc_p10.b2" crc="3c0a4eeb"/>
        <part name="cc_p9.a2" crc="b58c5f24"/>
        <!-- Total 0x156C00 bytes - 1371 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fd,77">
        <DSW1/>
        <dip name="Cabinet" bits="1" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="2" ids="5,3"/>
        <dip name="Coinage" bits="3,5" ids="Free Play,5/1,5/1,2/1,3/1,1/3,1/2,1/1"/>
        <DSW2/>
        <dip name="Game mode" bits="11,12" ids="Freeze,Infinite Lives,Demo Sounds On,Demo Sounds Off"/>
        <dip name="Flip Screen" bits="13" ids="On,Off"/>
        <dip name="Must Be On" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="button 1,button 2,-,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
