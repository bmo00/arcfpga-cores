<misterromdescription>
    <about author="snk-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>vertical (ccw)</rotation>
    <name>Guevara (Japan)</name>
    <setname>gwarj</setname>
    <mameversion>0289</mameversion>
    <year>1987</year>
    <manufacturer>SNK</manufacturer>
    <players>2</players>
    <rbf>gwar</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="gwarj.zip|gwar.zip" md5="None" asm_md5="39ebe88c20e266868707ec1a0d00c839">
        <!-- maincpu - starts at 0x0 - length 0x10000 (16 bits) -->
        <part name="1.2g" crc="7f8a880c"/>
        <!-- JTFRAME_BA1_START -->
        <!-- sub - starts at 0x10000 - length 0x10000 (16 bits) -->
        <part name="2.6g" crc="86d931bf"/>
        <!-- PCM_START -->
        <!-- ym2 - starts at 0x20000 - length 0x10000 (16 bits) -->
        <part name="4.2j" crc="2255f8dd"/>
        <!-- JTFRAME_BA2_START -->
        <!-- audiocpu - starts at 0x30000 - length 0x10000 (16 bits) -->
        <part name="3.7g" crc="eb544ab9"/>
        <!-- BG_START -->
        <!-- bg_tiles - starts at 0x40000 - length 0x40000 (18 bits) -->
        <part name="18.8x" crc="f1dcdaef"/>
        <part name="19.8z" crc="326e4e5e"/>
        <part name="gw20.8aa" crc="0aa70967"/>
        <part name="21.8ac" crc="b7686336"/>
        <!-- JTFRAME_BA3_START -->
        <!-- sp16_tiles - starts at 0x80000 - length 0x40000 (18 bits) -->
        <interleave output="32">
            <part name="gw6.2j" crc="58600f7d" map="0001"/>
            <part name="7.2l" crc="a3f9b463" map="0010"/>
            <part name="gw8.2m" crc="092501be" map="0100"/>
            <part name="gw9.2p" crc="25801ea6" map="1000"/>
        </interleave>
        <!-- SP32_START -->
        <!-- sp32_tiles - starts at 0xC0000 - length 0x80000 (19 bits) -->
        <interleave output="32">
            <part name="16.2ab" crc="2b46edff" map="0001"/>
            <part name="14.2y" crc="2d653f0c" map="0010"/>
            <part name="12.2v" crc="aeb3707f" map="0100"/>
            <part name="10.2s" crc="8dfc7b87" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="17.2ad" crc="be19888d" map="0001"/>
            <part name="15.2aa" crc="ebbf3ba2" map="0010"/>
            <part name="13.2w" crc="0808f95f" map="0100"/>
            <part name="11.2t" crc="06822aac" map="1000"/>
        </interleave>
        <!-- JTFRAME_PROM_START -->
        <!-- tx_tiles - starts at 0x140000 - length 0x8000 (15 bits) -->
        <part name="gw5.8p" crc="99d7ddf3"/>
        <!-- proms - starts at 0x148000 - length 0xC00 (12 bits) -->
        <part name="3.9w" crc="090236a3"/>
        <part name="2.9v" crc="9147de69"/>
        <part name="1.9u" crc="7f9c839e"/>
        <!-- Total 0x148C00 bytes - 1315 kBytes -->
    </rom>
    <!-- Vertical screen. Orientation reversed. -->
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fb,d9">
        <BONUS/>
        <dip name="Bonus Life" bits="2" ids="None,-,-,-,50k 100k 100k+,50k 100k,-,-,40k 80k 80k+,40k 80k,-,-,30k 60k 60k+,30k 60k"/>
        <DSW1/>
        <dip name="Allow Continue" bits="3" ids="No,Yes"/>
        <dip name="Flip Screen" bits="4" ids="On,Off"/>
        <dip name="Lives" bits="6" ids="5,3"/>
        <dip name="Coin A" bits="7,8" ids="4/1,3/1,2/1,1/1"/>
        <dip name="Coin B" bits="9,10" ids="1/2,1/3,1/4,1/6"/>
        <DSW2/>
        <dip name="Difficulty" bits="11,12" ids="Hardest,Hard,Normal,Easy"/>
        <dip name="Game Mode" bits="13,14" ids="Freeze,Infinite Lives,Demo Sounds On,Demo Sounds Off"/>
    </switches>
    <buttons names="Disparo,Granada,Girar izq.,Girar der.,Start,Coin,Core credits" default="A,B,X,Y,Start,Select,-" count="4"/>
</misterromdescription>
