<misterromdescription>
    <about author="snk-fpga" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>vertical (ccw)</rotation>
    <name>Ikari (Joystick hack bootleg)</name>
    <setname>ikarijpb</setname>
    <mameversion>0289</mameversion>
    <year>1986</year>
    <manufacturer>bootleg</manufacturer>
    <players>2</players>
    <rbf>gwar</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="ikarijpb.zip|ikari.zip" md5="None" asm_md5="5324e13c1536edde40c2c351dfad6368">
        <!-- maincpu - starts at 0x0 - length 0x10000 (16 bits) -->
        <part name="ik1.4l" crc="2ef87dce"/>
        <part name="p2.4k" crc="26948850"/>
        <part repeat="0x4000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- sub - starts at 0x10000 - length 0x10000 (16 bits) -->
        <part name="p3.8l" crc="9bb385f8"/>
        <part name="p4.8k" crc="3a144bca"/>
        <part repeat="0x4000"> FF</part>
        <!-- PCM_START -->
        <!-- ym2 - starts at 0x20000 - length 0x10000 (16 bits) -->
        <part repeat="0x10000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- audiocpu - starts at 0x30000 - length 0x10000 (16 bits) -->
        <part name="p5.6e" crc="863448fa"/>
        <part name="p6.6f" crc="9b16aa57"/>
        <part repeat="0x4000"> FF</part>
        <!-- BG_START -->
        <!-- bg_tiles - starts at 0x40000 - length 0x40000 (18 bits) -->
        <part name="p17.4d" crc="e0dba976"/>
        <part name="p18.2d" crc="24947d5f"/>
        <part name="p19.4b" crc="566242ec"/>
        <part name="p20.2b" crc="5da7ec1a"/>
        <part repeat="0x20000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- sp16_tiles - starts at 0x80000 - length 0x40000 (18 bits) -->
        <interleave output="32">
            <part name="p8.3d" crc="75d796d0" map="0001"/>
            <part name="p9.3f" crc="2c34903b" map="0010"/>
            <part name="p10.3h" crc="da9ccc94" map="0100"/>
            <part name="p10.3h" crc="da9ccc94" map="1000"/>
        </interleave>
        <part repeat="0x20000"> FF</part>
        <!-- SP32_START -->
        <!-- sp32_tiles - starts at 0xC0000 - length 0x80000 (19 bits) -->
        <interleave output="32">
            <part name="p11.4m" crc="5c75ea8f" map="0001"/>
            <part name="p12.4p" crc="95138498" map="0010"/>
            <part name="p13.4r" crc="315383d7" map="0100"/>
            <part name="p11.4m" crc="5c75ea8f" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="p14.2m" crc="3293fde4" map="0001"/>
            <part name="p15.2p" crc="65a61c99" map="0010"/>
            <part name="p16.2r" crc="e9b03e07" map="0100"/>
            <part name="p11.4m" crc="5c75ea8f" map="1000"/>
        </interleave>
        <part repeat="0x40000"> FF</part>
        <!-- JTFRAME_PROM_START -->
        <!-- tx_tiles - starts at 0x140000 - length 0x4000 (14 bits) -->
        <part name="p7.3b" crc="9e88f536"/>
        <!-- proms - starts at 0x144000 - length 0xC00 (12 bits) -->
        <part name="1.1h" crc="b9bf2c2c"/>
        <part name="2.2j" crc="0703a770"/>
        <part name="3.1j" crc="0a11cdde"/>
        <!-- Total 0x144C00 bytes - 1299 kBytes -->
    </rom>
    <!-- Vertical screen. Orientation reversed. -->
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,d9">
        <BONUS/>
        <dip name="Bonus Life" bits="2" ids="None,-,-,-,100k 200k,100k 200k 200k+,-,-,60k 120k,60k 120k 120k+,-,-,50k 100k,50k 100k 100k+"/>
        <DSW1/>
        <dip name="Allow killing each other" bits="3" ids="Yes,No"/>
        <dip name="P1 &amp; P2 Fire Buttons" bits="4" ids="Common,Separate"/>
        <dip name="Lives" bits="6" ids="5,3"/>
        <dip name="Coin A" bits="7,8" ids="4/1,3/1,2/1,1/1"/>
        <dip name="Coin B" bits="9,10" ids="1/2,1/3,1/4,1/6"/>
        <DSW2/>
        <dip name="Difficulty" bits="11,12" ids="Hardest,Hard,Normal,Easy"/>
        <dip name="Game Mode" bits="13,14" ids="Infinite Lives,Freeze,Demo Sounds On,Demo Sounds Off"/>
    </switches>
    <buttons names="button 1,button 2,-,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
