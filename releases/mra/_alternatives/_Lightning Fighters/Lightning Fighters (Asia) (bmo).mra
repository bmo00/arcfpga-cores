<misterromdescription>
    <about author="jotego" source="https://github.com/bmo00/arcfpga-cores"/>
    <rotation>horizontal</rotation>
    <name>Lightning Fighters (Asia)</name>
    <setname>lgtnfghta</setname>
    <mameversion>0288</mameversion>
    <year>1990</year>
    <manufacturer>Konami</manufacturer>
    <players>2</players>
    <rbf>jtriders</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="lgtnfghta.zip|lgtnfght.zip" md5="None" address="0x30000000" asm_md5="917ae975b1f64eb63d44ee00282a8b70">
        <!-- Offsets for each ROM region. Byte 15 = game selection. -->
        <part>
            00 00 40 00 D0 00 D0 01
            FF FF 00 00 00 00 00 04
        </part>
        <!-- maincpu - starts at 0x0 - length 0x40000 (18 bits) -->
        <interleave output="16">
            <part name="939j_03.e15" crc="8d4da7b7" map="01"/>
            <part name="939j_02.e11" crc="bbbb4a74" map="10"/>
        </interleave>
        <!-- audiocpu - starts at 0x40000 - length 0x10000 (16 bits) -->
        <part name="939e01.d7" crc="4a5fc848"/>
        <part name="939e01.d7" crc="4a5fc848"/>
        <!-- pcm - starts at 0x50000 - length 0x80000 (19 bits) -->
        <part name="939a04.c5" crc="c24e2b6e"/>
        <!-- k052109 - starts at 0xD0000 - length 0x100000 (20 bits) -->
        <interleave output="32">
            <part name="939a07.k14" crc="7955dfcf" map="0021"/>
            <part name="939a08.k19" crc="ed95b385" map="2100"/>
        </interleave>
        <!-- obj - starts at 0x1D0000 - length 0x100000 (20 bits) -->
        <interleave output="32">
            <part name="939a06.k8" crc="e393c206" map="0021"/>
            <part name="939a05.k2" crc="3662d47a" map="2100"/>
        </interleave>
        <!-- z-tiles - starts at 0x2D0000 -->
        <!-- z-tilemap - starts at 0x2D0000 -->
        <!-- Total 0x2D0000 bytes - 2880 kBytes -->
    </rom>
    <nvram index="2" size="41153"/>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <buttons names="button 1,button 2,-,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
